rules_version = '2';

// DOCRS Firestore security rules.
//
// Threat model: the Firebase API key is public (it ships in every app build), so
// these rules and App Check are the only protection. They guarantee:
//   1. Nobody can read or write anything unless signed in.
//   2. Every write has known fields, correct types and bounded sizes.
//   3. Team data isolation & role enforcement (Owner, Editor, Assistant, Viewer).
//   4. Every list query must carry a limit, so a client cannot scan the database.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- roles --
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasRole() {
      return request.auth != null && exists(userPath());
    }
    function role() {
      return get(userPath()).data.role;
    }
    function isStaff() {
      return hasRole() && role() in ['admin', 'physician', 'staff'];
    }
    function isPhysician() {
      return hasRole() && role() in ['admin', 'physician'];
    }

    // --------------------------------------------------- team permissions --
    function memberPath(teamId, uid) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid);
    }
    function isTeamMember(teamId) {
      return request.auth != null && (
        isStaff() ||
        (teamId != null && teamId != '' && (
          exists(memberPath(teamId, request.auth.uid)) ||
          (resource != null && resource.data.get('ownerId', '') == request.auth.uid)
        ))
      );
    }
    function memberRole(teamId) {
      return get(memberPath(teamId, request.auth.uid)).data.role;
    }
    function isTeamOwner(teamId) {
      return request.auth != null && (
        isStaff() ||
        (teamId != null && teamId != '' && exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId) == 'owner') ||
        (resource != null && resource.data.get('ownerId', '') == request.auth.uid)
      );
    }
    function canViewPatients(teamId) {
      return request.auth != null && (
        isStaff() ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId) in ['owner', 'editor', 'assistant', 'viewer'])
      );
    }
    function canEditPatients(teamId) {
      return request.auth != null && (
        isStaff() ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId) in ['owner', 'editor', 'assistant'])
      );
    }
    function canViewVisits(teamId) {
      return request.auth != null && (
        isPhysician() ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId) in ['owner', 'editor', 'viewer'])
      );
    }
    function canWriteVisits(teamId) {
      return request.auth != null && (
        isPhysician() ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId) in ['owner', 'editor'])
      );
    }

    // ------------------------------------------------------------- counters --
    function countersPath() {
      return /databases/$(database)/documents/meta/counters;
    }
    function countBefore(field) {
      return exists(countersPath()) ? get(countersPath()).data.get(field, 0) : 0;
    }
    function countAfter(field) {
      return existsAfter(countersPath()) ? getAfter(countersPath()).data.get(field, 0) : 0;
    }
    function bumped(field, cap) {
      return countAfter(field) == countBefore(field) + 1 && countAfter(field) <= cap;
    }
    function unchanged(field) {
      return countAfter(field) == countBefore(field);
    }

    // ------------------------------------------------------ value validators --
    function s(d, k, max) {
      let v = d.get(k, '');
      return v is string && v.size() <= max;
    }
    function sn(d, k, max) {
      let v = d.get(k, '');
      return v == null || (v is string && v.size() <= max);
    }
    function optInt(d, k, lo, hi) {
      let v = d.get(k, lo);
      return v is int && v >= lo && v <= hi;
    }
    function optBool(d, k) {
      return d.get(k, false) is bool;
    }
    function strList(l, maxItems, maxChars) {
      return l is list && l.size() <= maxItems && l.join(',').size() <= maxChars;
    }
    function bytesUpTo(d, k, max) {
      let v = d.get(k, null);
      return v == null || (v is bytes && v.size() <= max);
    }

    // ---------------------------------------------------------------- teams --
    function validTeam(d, id) {
      return d.keys().hasOnly(['id', 'name', 'ownerId', 'inviteCode', 'createdAt', 'patientCount', 'encounterCount', 'prescriptionCount'])
        && d.keys().hasAll(['id', 'name', 'ownerId', 'inviteCode'])
        && d.id == id
        && s(d, 'name', 100) && s(d, 'ownerId', 128) && s(d, 'inviteCode', 32)
        && s(d, 'createdAt', 64)
        && optInt(d, 'patientCount', 0, 100000)
        && optInt(d, 'encounterCount', 0, 100000)
        && optInt(d, 'prescriptionCount', 0, 100000);
    }

    match /teams/{teamId} {
      allow get: if isTeamMember(teamId) || (request.auth != null && resource.data.get('ownerId', '') == request.auth.uid);
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && validTeam(request.resource.data, teamId);
      allow update: if isTeamOwner(teamId) && validTeam(request.resource.data, teamId);
      allow delete: if isTeamOwner(teamId);

      function validMember(d, uid) {
        return d.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'joinedAt'])
          && d.keys().hasAll(['uid', 'role'])
          && d.uid == uid
          && s(d, 'email', 200) && s(d, 'displayName', 200) && s(d, 'joinedAt', 64)
          && d.role in ['owner', 'editor', 'assistant', 'viewer'];
      }

      match /members/{uid} {
        allow get, list: if isTeamMember(teamId);
        allow create: if (isTeamOwner(teamId) || request.auth.uid == uid) && validMember(request.resource.data, uid);
        allow update: if isTeamOwner(teamId) && validMember(request.resource.data, uid);
        allow delete: if isTeamOwner(teamId) || (request.auth != null && request.auth.uid == uid);
      }
    }

    // Collection group rule for querying team members across teams
    match /{path=**}/members/{uid} {
      allow read: if request.auth != null;
    }

    // ------------------------------------------------------------- patients --
    function validPatient(d, pid) {
      return d.keys().hasOnly([
          'id', 'mrn', 'fullName', 'middleName', 'dateOfBirth', 'gender', 'phone',
          'address', 'occupation', 'phicNumber', 'referringDoctor', 'notes', 'medicalHistory',
          'allergies', 'previousDiagnoses', 'previousPrescriptions', 'lastVisitDate',
          'totalVisits', 'lastModified', 'teamId'])
        && d.keys().hasAll(['id', 'mrn', 'fullName', 'dateOfBirth', 'gender', 'phone', 'address'])
        && d.id == pid
        && s(d, 'mrn', 300) && s(d, 'fullName', 300) && s(d, 'middleName', 300)
        && s(d, 'dateOfBirth', 300) && s(d, 'gender', 300) && s(d, 'phone', 300)
        && s(d, 'address', 300) && s(d, 'occupation', 300) && s(d, 'phicNumber', 300)
        && sn(d, 'referringDoctor', 300) && s(d, 'notes', 1000) && s(d, 'lastVisitDate', 300)
        && s(d, 'lastModified', 64) && sn(d, 'teamId', 300)
        && optInt(d, 'totalVisits', 0, 100000)
        && strList(d.get('medicalHistory', []), 15, 4600)
        && strList(d.get('allergies', []), 15, 4600)
        && strList(d.get('previousDiagnoses', []), 10, 3100)
        && strList(d.get('previousPrescriptions', []), 10, 3100);
    }

    match /patients/{pid} {
      allow get: if canViewPatients(resource.data.get('teamId', ''));
      allow list: if isStaff() && request.query.limit <= 1000;
      allow create: if canEditPatients(request.resource.data.get('teamId', ''))
                    && validPatient(request.resource.data, pid)
                    && (bumped('patientCount', 1000) || request.resource.data.get('teamId', '') != '');
      allow update: if canEditPatients(request.resource.data.get('teamId', ''))
                    && validPatient(request.resource.data, pid)
                    && unchanged('patientCount');
      allow delete: if false;

      // -------------------------------------------------------------- visits --
      function validExam(e) {
        return e is map
          && e.keys().hasOnly([
              'acuity', 'refraction', 'color', 'iop', 'iopMethod', 'anglesGonioscopy',
              'cdrOn', 'confrontationPeripheral', 'vanHerick', 'slitLampNotes',
              'fundoscopyNotes'])
          && e.get('acuity', {}) is map
          && e.get('acuity', {}).keys().hasOnly(['uncorrected', 'bestCorrected', 'pinhole', 'oldCc', 'ar', 'ak'])
          && e.get('refraction', {}) is map
          && e.get('refraction', {}).keys().hasOnly(['sph', 'cyl', 'axis', 'add'])
          && s(e, 'color', 300) && s(e, 'iop', 300) && s(e, 'iopMethod', 300)
          && s(e, 'anglesGonioscopy', 300) && s(e, 'cdrOn', 300)
          && s(e, 'confrontationPeripheral', 300) && s(e, 'vanHerick', 300)
          && s(e, 'slitLampNotes', 1000) && s(e, 'fundoscopyNotes', 1000);
      }
      function validEncounter(d, pid, eid) {
        return d.keys().hasOnly([
            'id', 'patientId', 'date', 'doctorName', 'chiefComplaint', 'examOD', 'examOS',
            'diagnosis', 'treatmentPlan', 'status', 'lastModified', 'paperSheet',
            'drawOD', 'drawOS', 'teamId'])
          && d.keys().hasAll(['id', 'patientId', 'date', 'lastModified'])
          && d.id == eid && d.patientId == pid
          && s(d, 'date', 300) && s(d, 'doctorName', 300) && s(d, 'status', 300)
          && s(d, 'lastModified', 64) && sn(d, 'teamId', 300)
          && s(d, 'chiefComplaint', 2000) && s(d, 'diagnosis', 2000) && s(d, 'treatmentPlan', 2000)
          && validExam(d.get('examOD', {}))
          && validExam(d.get('examOS', {}))
          && bytesUpTo(d, 'paperSheet', 20480)
          && bytesUpTo(d, 'drawOD', 8192)
          && bytesUpTo(d, 'drawOS', 8192);
      }

      match /encounters/{eid} {
        allow get: if canViewVisits(resource.data.get('teamId', get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')));
        allow list: if canViewVisits(get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')) && request.query.limit <= 200;
        allow create: if canWriteVisits(request.resource.data.get('teamId', get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')))
                      && validEncounter(request.resource.data, pid, eid)
                      && (bumped('encounterCount', 20000) || request.resource.data.get('teamId', '') != '');
        allow update: if canWriteVisits(request.resource.data.get('teamId', get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')))
                      && validEncounter(request.resource.data, pid, eid)
                      && unchanged('encounterCount');
        allow delete: if false;
      }

      // -------------------------------------------------------- prescriptions --
      function validRxItem(l, i) {
        return l.size() <= i || (
          l[i].keys().hasOnly(['id', 'medicationName', 'strength', 'dosage', 'frequency', 'duration', 'instructions'])
          && l[i].get('medicationName', '').size() <= 200
          && l[i].get('instructions', '').size() <= 300);
      }
      function validRxItems(l) {
        return l is list && l.size() <= 10
          && validRxItem(l, 0) && validRxItem(l, 1) && validRxItem(l, 2) && validRxItem(l, 3)
          && validRxItem(l, 4) && validRxItem(l, 5) && validRxItem(l, 6) && validRxItem(l, 7)
          && validRxItem(l, 8) && validRxItem(l, 9);
      }
      function validPrescription(d, pid, rid) {
        return d.keys().hasOnly([
            'id', 'patientId', 'encounterId', 'doctorName', 'date', 'items', 'notes',
            'lastModified', 'teamId'])
          && d.keys().hasAll(['id', 'patientId', 'items', 'lastModified'])
          && d.id == rid && d.patientId == pid
          && s(d, 'encounterId', 300) && s(d, 'doctorName', 300) && s(d, 'date', 300)
          && s(d, 'notes', 1000) && s(d, 'lastModified', 64) && sn(d, 'teamId', 300)
          && validRxItems(d.items);
      }

      match /prescriptions/{rid} {
        allow get: if canViewVisits(resource.data.get('teamId', get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')));
        allow list: if canViewVisits(get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')) && request.query.limit <= 200;
        allow create: if canWriteVisits(request.resource.data.get('teamId', get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')))
                      && validPrescription(request.resource.data, pid, rid)
                      && (bumped('prescriptionCount', 20000) || request.resource.data.get('teamId', '') != '');
        allow update: if canWriteVisits(request.resource.data.get('teamId', get(/databases/$(database)/documents/patients/$(pid)).data.get('teamId', '')))
                      && validPrescription(request.resource.data, pid, rid)
                      && unchanged('prescriptionCount');
        allow delete: if false;
      }
    }

    // ------------------------------------------------------- meta / counters --
    function counterStep(d, f, cap) {
      let before = resource == null ? 0 : resource.data.get(f, 0);
      let after = d.get(f, 0);
      return after is int && after >= before && after - before <= 1 && after <= cap;
    }
    function validCounters(d) {
      return d.keys().hasOnly(['patientCount', 'encounterCount', 'prescriptionCount'])
        && counterStep(d, 'patientCount', 1000)
        && counterStep(d, 'encounterCount', 20000)
        && counterStep(d, 'prescriptionCount', 20000);
    }

    match /meta/counters {
      allow get: if isStaff();
      allow list: if false;
      allow create, update: if isStaff() && validCounters(request.resource.data);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- users --
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ------------------------------------------------------ calendar & alerts --
    function validEvent(d, id) {
      return d.keys().hasOnly([
          'id', 'title', 'eventType', 'location', 'dateTime', 'patientName', 'patientId',
          'notes', 'reminderMinutes', 'isCompleted', 'lastModified', 'teamId'])
        && d.get('id', id) == id
        && s(d, 'title', 300) && s(d, 'eventType', 300) && s(d, 'location', 300)
        && s(d, 'dateTime', 64) && s(d, 'patientName', 300) && sn(d, 'patientId', 300)
        && s(d, 'notes', 1000) && s(d, 'lastModified', 64) && sn(d, 'teamId', 300)
        && optInt(d, 'reminderMinutes', 0, 10080)
        && optBool(d, 'isCompleted');
    }

    match /calendarEvents/{id} {
      allow get: if isStaff() || canViewPatients(resource.data.get('teamId', ''));
      allow list: if isStaff() && request.query.limit <= 500;
      allow create, update: if (isStaff() || canEditPatients(request.resource.data.get('teamId', '')))
                            && validEvent(request.resource.data, id);
      allow delete: if isStaff() || isTeamOwner(resource.data.get('teamId', ''));
    }

    function validNotification(d, id) {
      return d.keys().hasOnly([
          'id', 'title', 'message', 'category', 'severity', 'timestamp', 'patientName',
          'patientId', 'isRead', 'teamId'])
        && d.get('id', id) == id
        && s(d, 'title', 300) && s(d, 'message', 1000) && s(d, 'category', 300)
        && s(d, 'severity', 300) && s(d, 'timestamp', 64)
        && sn(d, 'patientName', 300) && sn(d, 'patientId', 300) && sn(d, 'teamId', 300)
        && optBool(d, 'isRead');
    }

    match /notifications/{id} {
      allow get: if isStaff() || canViewPatients(resource.data.get('teamId', ''));
      allow list: if isStaff() && request.query.limit <= 500;
      allow create, update: if (isStaff() || canEditPatients(request.resource.data.get('teamId', '')))
                            && validNotification(request.resource.data, id);
      allow delete: if isStaff() || isTeamOwner(resource.data.get('teamId', ''));
    }

    // ---------------------------------------------------------- everything else --
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
