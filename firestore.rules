rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: teams/{teamId}
//   - id: string (required, max 128)
//   - name: string (required, max 100)
//   - location: string (optional, max 200)
//   - ownerId: string (required, max 128)
//   - inviteCode: string (required, max 32)
//   - createdAt: string (required, max 64)
//   - patientCount: int (optional, 0..100000)
//   - encounterCount: int (optional, 0..100000)
//   - prescriptionCount: int (optional, 0..100000)
//   - isArchived: bool (optional)
//
// Collection: teams/{teamId}/members/{uid}
//   - uid: string (required, max 128)
//   - email: string (optional, max 200)
//   - displayName: string (optional, max 200)
//   - role: string (required: 'owner' | 'editor' | 'assistant' | 'viewer')
//   - joinedAt: string (optional, max 64)
//   - status: string (optional, max 32: 'active' | 'pending')
//
// Collection: patients/{pid}
//   - id, mrn, fullName, dateOfBirth, gender, phone, address (required)
//   - firstName, middleName, lastName, occupation, phicNumber, referringDoctor (optional)
//   - notes, medicalHistory, allergies, previousDiagnoses, previousPrescriptions (optional)
//   - lastVisitDate, totalVisits, lastModified, teamId, createdAt (optional)
//
// Collection: patients/{pid}/encounters/{eid}
//   - id, patientId, date, lastModified (required)
//   - doctorName, chiefComplaint, examOD, examOS, diagnosis, treatmentPlan, status, teamId
//   - paperSheet, drawOD, drawOS (optional byte blobs)
//
// Collection: patients/{pid}/prescriptions/{rid}
//   - id, patientId, items, lastModified (required)
//   - encounterId, doctorName, date, notes, teamId, clinicBranch, followUpDate (optional)
//
// Collection: users/{uid}
//   - role, status, email, displayName, twoFactorEnabled, twoFactorPhoneNumber, updatedAt
//   Subcollections: settings/{docId}, preferences/{docId}
//
// Collection: meta/counters
//   - patientCount, encounterCount, prescriptionCount (int counters)
//
// Collection: calendarEvents/{id}
//   - id, title, eventType, location, dateTime, patientName, patientId, notes, reminderMinutes, isCompleted, teamId
//
// Collection: notifications/{id}
//   - id, title, message, category, severity, timestamp, patientName, patientId, isRead, teamId
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- roles --
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasRole() {
      return request.auth != null && (
        (request.auth.token.get('role', '') != '') ||
        exists(userPath())
      );
    }
    function role() {
      return request.auth.token.get('role', '') != ''
        ? request.auth.token.role
        : (exists(userPath()) ? get(userPath()).data.get('role', '') : '');
    }
    function roleLower() {
      let r = request.auth.token.get('role', '');
      return r != ''
        ? r.lower()
        : (exists(userPath()) ? get(userPath()).data.get('role', '').lower() : '');
    }
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin.docrs@gmail.com' ||
        request.auth.token.get('email', '') == 'admin.docrs@gmail.com' ||
        request.auth.token.get('email', '').lower() == 'admin.docrs@gmail.com'
      );
    }
    function isStaff() {
      return request.auth != null && (
        isMasterAdmin() ||
        roleLower() in ['admin', 'physician', 'staff', 'owner', 'editor', 'assistant', 'doctor', 'leader'] ||
        request.auth.token.get('role', '').lower() in ['admin', 'physician', 'staff', 'owner', 'editor', 'assistant', 'doctor', 'leader']
      );
    }
    function isPhysician() {
      return request.auth != null && (
        isMasterAdmin() ||
        roleLower() in ['admin', 'physician', 'owner', 'editor', 'doctor'] ||
        request.auth.token.get('role', '').lower() in ['admin', 'physician', 'owner', 'editor', 'doctor']
      );
    }

    // --------------------------------------------------- team permissions --
    function memberPath(teamId, uid) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid);
    }
    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function teamOwnerId(teamId) {
      return (teamId != null && teamId != '' && exists(teamPath(teamId)))
        ? get(teamPath(teamId)).data.get('ownerId', '')
        : '';
    }
    function tokenWorkspaceMatches(teamId) {
      return request.auth != null && teamId != null && teamId != '' && (
        request.auth.token.get('teamId', '') == teamId ||
        request.auth.token.get('workspaceId', '') == teamId ||
        request.auth.token.get('activeWorkspaceId', '') == teamId
      );
    }
    function isTeamMember(teamId) {
      return request.auth != null && (
        isMasterAdmin() ||
        isStaff() ||
        tokenWorkspaceMatches(teamId) ||
        (teamId != null && teamId != '' && (
          exists(memberPath(teamId, request.auth.uid)) ||
          teamOwnerId(teamId) == request.auth.uid ||
          (resource != null && (resource.data.get('ownerId', '') == request.auth.uid || resource.data.ownerId == request.auth.uid))
        ))
      );
    }
    function memberRole(teamId) {
      return tokenWorkspaceMatches(teamId) && request.auth.token.get('role', '') != ''
        ? request.auth.token.role
        : (exists(memberPath(teamId, request.auth.uid))
            ? get(memberPath(teamId, request.auth.uid)).data.get('role', 'viewer')
            : (teamOwnerId(teamId) == request.auth.uid ? 'owner' : 'viewer'));
    }
    function isTeamOwner(teamId) {
      return request.auth != null && (
        isMasterAdmin() ||
        isStaff() ||
        (teamId != null && teamId != '' && teamOwnerId(teamId) == request.auth.uid) ||
        (tokenWorkspaceMatches(teamId) && request.auth.token.get('role', '').lower() in ['owner', 'leader', 'admin']) ||
        (teamId != null && teamId != '' && exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId).lower() in ['owner', 'leader', 'admin']) ||
        (teamId != null && teamId != '' && exists(memberPath(teamId, request.auth.uid)) && get(memberPath(teamId, request.auth.uid)).data.get('role', '').lower() in ['owner', 'leader', 'admin']) ||
        (resource != null && (resource.data.get('ownerId', '') == request.auth.uid || resource.data.ownerId == request.auth.uid || resource.data.get('adminId', '') == request.auth.uid))
      );
    }
    function isTeamAdmin(teamId) {
      return request.auth != null && (
        isMasterAdmin() ||
        isTeamOwner(teamId) ||
        roleLower() in ['admin', 'owner', 'leader'] ||
        (tokenWorkspaceMatches(teamId) && request.auth.token.get('role', '').lower() in ['owner', 'leader', 'admin']) ||
        (teamId != null && teamId != '' && exists(memberPath(teamId, request.auth.uid)) && (
          memberRole(teamId).lower() in ['owner', 'leader', 'admin'] ||
          get(memberPath(teamId, request.auth.uid)).data.get('role', '').lower() in ['owner', 'leader', 'admin']
        )) ||
        (exists(userPath()) && get(userPath()).data.get('teamRole', '').lower() in ['owner', 'admin', 'leader']) ||
        (resource != null && (resource.data.get('ownerId', '') == request.auth.uid || resource.data.ownerId == request.auth.uid || resource.data.get('adminId', '') == request.auth.uid))
      );
    }
    function canViewPatients(teamId) {
      return request.auth != null && (
        isStaff() ||
        teamId == null || teamId == '' ||
        isTeamOwner(teamId) ||
        tokenWorkspaceMatches(teamId) ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId).lower() in ['owner', 'editor', 'assistant', 'viewer'])
      );
    }
    function canEditPatients(teamId) {
      return request.auth != null && (
        isStaff() ||
        teamId == null || teamId == '' ||
        isTeamOwner(teamId) ||
        (tokenWorkspaceMatches(teamId) && request.auth.token.get('role', 'editor').lower() in ['owner', 'editor', 'assistant']) ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId).lower() in ['owner', 'editor', 'assistant'])
      );
    }
    function canViewVisits(teamId) {
      return request.auth != null && (
        isPhysician() ||
        teamId == null || teamId == '' ||
        isTeamOwner(teamId) ||
        (tokenWorkspaceMatches(teamId) && request.auth.token.get('role', 'editor').lower() in ['owner', 'editor', 'viewer']) ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId).lower() in ['owner', 'editor', 'viewer'])
      );
    }
    function canWriteVisits(teamId) {
      return request.auth != null && (
        isPhysician() ||
        teamId == null || teamId == '' ||
        isTeamOwner(teamId) ||
        (tokenWorkspaceMatches(teamId) && request.auth.token.get('role', 'editor').lower() in ['owner', 'editor']) ||
        (exists(memberPath(teamId, request.auth.uid)) && memberRole(teamId).lower() in ['owner', 'editor'])
      );
    }

    function patientTeamId(pid) {
      let pPath = /databases/$(database)/documents/patients/$(pid);
      return exists(pPath) ? get(pPath).data.get('teamId', '') :
             existsAfter(pPath) ? getAfter(pPath).data.get('teamId', '') : '';
    }

    // ------------------------------------------------------------- counters --
    function countersPath() {
      return /databases/$(database)/documents/meta/counters;
    }
    function countBefore(field) {
      return exists(countersPath()) ? get(countersPath()).data.get(field, 0) : 0;
    }
    function countAfter(field) {
      return existsAfter(countersPath()) ? getAfter(countersPath()).data.get(field, 0) : 0;
    }
    function bumped(field, cap) {
      return countAfter(field) == countBefore(field) + 1 && countAfter(field) <= cap;
    }
    function unchanged(field) {
      return countAfter(field) == countBefore(field);
    }

    // ------------------------------------------------------ value validators --
    function s(d, k, max) {
      let v = d.get(k, '');
      return v is string && v.size() <= max;
    }
    function sn(d, k, max) {
      let v = d.get(k, '');
      return v == null || (v is string && v.size() <= max);
    }
    function optInt(d, k, lo, hi) {
      let v = d.get(k, null);
      return v == null || (v is int && v >= lo && v <= hi);
    }
    function optBool(d, k) {
      let v = d.get(k, null);
      return v == null || v is bool;
    }
    function strList(l, maxItems, maxChars) {
      return l is list && l.size() <= maxItems && l.join(',').size() <= maxChars;
    }
    function bytesUpTo(d, k, max) {
      let v = d.get(k, null);
      return v == null || (v is bytes && v.size() <= max);
    }

    // ---------------------------------------------------------------- teams --
    function validTeam(d, id) {
      return d.keys().hasOnly([
          'id', 'name', 'location', 'clinicLocation', 'address',
          'ownerId', 'inviteCode', 'createdAt', 'updatedAt', 'archivedAt',
          'patientCount', 'encounterCount', 'prescriptionCount', 'isArchived',
          'description', 'adminId', 'prescriptionSettings', 'ownerEmail',
          'ownerName', 'status', 'membersCount', 'memberCount', 'settings'
        ])
        && d.keys().hasAll(['name', 'ownerId'])
        && d.get('id', id) == id
        && s(d, 'name', 100)
        && sn(d, 'location', 200)
        && sn(d, 'clinicLocation', 200)
        && sn(d, 'address', 200)
        && s(d, 'ownerId', 128)
        && sn(d, 'inviteCode', 32)
        && (sn(d, 'createdAt', 64) || d.get('createdAt', null) is timestamp)
        && (sn(d, 'updatedAt', 64) || d.get('updatedAt', null) is timestamp)
        && (sn(d, 'archivedAt', 64) || d.get('archivedAt', null) is timestamp)
        && sn(d, 'description', 500)
        && sn(d, 'adminId', 128)
        && optInt(d, 'patientCount', 0, 100000)
        && optInt(d, 'encounterCount', 0, 100000)
        && optInt(d, 'prescriptionCount', 0, 100000)
        && optBool(d, 'isArchived')
        && (d.get('prescriptionSettings', null) == null || d.get('prescriptionSettings', null) is map);
    }

    match /teams/{teamId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create: if request.auth != null && (
        isMasterAdmin() ||
        request.auth.token.email == "admin.docrs@gmail.com" ||
        request.resource.data.ownerId == request.auth.uid
      ) && validTeam(request.resource.data, teamId);
      allow update: if request.auth != null && (
        isMasterAdmin() ||
        request.auth.token.email == "admin.docrs@gmail.com" ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        isTeamOwner(teamId) ||
        isTeamAdmin(teamId)
      ) && (
        isMasterAdmin() ||
        request.auth.token.email == "admin.docrs@gmail.com" ||
        validTeam(request.resource.data, teamId)
      );
      allow delete: if request.auth != null && (
        isMasterAdmin() ||
        request.auth.token.email == "admin.docrs@gmail.com" ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        isTeamOwner(teamId)
      );

      function validMember(d, uid) {
        return d.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'joinedAt', 'status',
            'isApproved', 'targetWorkspaceId', 'requestedWorkspaceId', 'workspaceId', 'teamId', 'requestedAt',
            'createdAt', 'updatedAt', 'inviteCode', 'requestedRole'
          ])
          && d.keys().hasAll(['uid', 'role'])
          && d.get('uid', uid) == uid
          && sn(d, 'email', 200) && sn(d, 'displayName', 200)
          && (sn(d, 'joinedAt', 64) || d.get('joinedAt', null) is timestamp)
          && (sn(d, 'requestedAt', 64) || d.get('requestedAt', null) is timestamp)
          && (sn(d, 'createdAt', 64) || d.get('createdAt', null) is timestamp)
          && (sn(d, 'updatedAt', 64) || d.get('updatedAt', null) is timestamp)
          && sn(d, 'status', 32)
          && optBool(d, 'isApproved')
          && sn(d, 'targetWorkspaceId', 128)
          && sn(d, 'requestedWorkspaceId', 128)
          && sn(d, 'workspaceId', 128)
          && sn(d, 'teamId', 128)
          && sn(d, 'inviteCode', 32)
          && sn(d, 'requestedRole', 32)
          && d.get('role', '').lower() in ['owner', 'editor', 'assistant', 'viewer', 'pending', 'admin', 'leader'];
      }

      function validJoinRequest(d, uid) {
        return d.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'joinedAt', 'status',
            'isApproved', 'targetWorkspaceId', 'requestedWorkspaceId', 'workspaceId', 'teamId', 'requestedAt',
            'createdAt', 'updatedAt', 'inviteCode', 'requestedRole'
          ])
          && d.get('uid', uid) == uid
          && sn(d, 'email', 200) && sn(d, 'displayName', 200)
          && (sn(d, 'joinedAt', 64) || d.get('joinedAt', null) is timestamp)
          && (sn(d, 'requestedAt', 64) || d.get('requestedAt', null) is timestamp)
          && (sn(d, 'createdAt', 64) || d.get('createdAt', null) is timestamp)
          && (sn(d, 'updatedAt', 64) || d.get('updatedAt', null) is timestamp)
          && sn(d, 'status', 32)
          && optBool(d, 'isApproved')
          && sn(d, 'targetWorkspaceId', 128)
          && sn(d, 'requestedWorkspaceId', 128)
          && sn(d, 'workspaceId', 128)
          && sn(d, 'teamId', 128)
          && sn(d, 'inviteCode', 32)
          && sn(d, 'requestedRole', 32);
      }

      match /members/{uid} {
        allow get: if (request.auth != null && request.auth.uid == uid) || isTeamMember(teamId) || isTeamOwner(teamId) || isTeamAdmin(teamId);
        allow list: if isTeamMember(teamId) || isTeamOwner(teamId) || isTeamAdmin(teamId);
        allow create: if request.auth != null && (isTeamOwner(teamId) || isTeamAdmin(teamId) || request.auth.uid == uid) && validMember(request.resource.data, uid);
        allow update: if request.auth != null && (isTeamOwner(teamId) || isTeamAdmin(teamId) || request.auth.uid == uid) && validMember(request.resource.data, uid);
        allow delete: if isTeamOwner(teamId) || isTeamAdmin(teamId) || (request.auth != null && request.auth.uid == uid);
      }

      match /joinRequests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isTeamMember(teamId) || isTeamOwner(teamId) || isTeamAdmin(teamId));
        allow list: if isTeamMember(teamId) || isTeamOwner(teamId) || isTeamAdmin(teamId);
        allow create, update: if request.auth != null && (request.auth.uid == uid || isTeamOwner(teamId) || isTeamAdmin(teamId)) && validJoinRequest(request.resource.data, uid);
        allow delete: if request.auth != null && (request.auth.uid == uid || isTeamOwner(teamId) || isTeamAdmin(teamId));
      }

      match /requests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isTeamMember(teamId) || isTeamOwner(teamId) || isTeamAdmin(teamId));
        allow list: if isTeamMember(teamId) || isTeamOwner(teamId) || isTeamAdmin(teamId);
        allow create, update: if request.auth != null && (request.auth.uid == uid || isTeamOwner(teamId) || isTeamAdmin(teamId)) && validJoinRequest(request.resource.data, uid);
        allow delete: if request.auth != null && (request.auth.uid == uid || isTeamOwner(teamId) || isTeamAdmin(teamId));
      }
    }

    // Collection group rule for querying team members across teams
    match /{path=**}/members/{uid} {
      allow read: if request.auth != null;
    }

    // Collection group rule for querying join requests across teams
    match /{path=**}/joinRequests/{uid} {
      allow read: if request.auth != null;
    }

    // ------------------------------------------------------------- patients --
    function validPatient(d, pid) {
      return d.keys().hasOnly([
          'id', 'mrn', 'firstName', 'middleName', 'lastName', 'fullName',
          'dateOfBirth', 'gender', 'phone', 'address', 'occupation', 'phicNumber',
          'referringDoctor', 'notes', 'medicalHistory', 'allergies', 'previousDiagnoses',
          'previousPrescriptions', 'lastVisitDate', 'totalVisits', 'lastModified',
          'teamId', 'createdAt'])
        && d.keys().hasAll(['id', 'mrn', 'fullName', 'dateOfBirth', 'gender', 'phone', 'address'])
        && d.id == pid
        && s(d, 'mrn', 300) && s(d, 'fullName', 300) && s(d, 'middleName', 300)
        && sn(d, 'firstName', 300) && sn(d, 'lastName', 300)
        && s(d, 'dateOfBirth', 300) && s(d, 'gender', 300) && s(d, 'phone', 300)
        && s(d, 'address', 300) && s(d, 'occupation', 300) && s(d, 'phicNumber', 300)
        && sn(d, 'referringDoctor', 300) && s(d, 'notes', 1000) && s(d, 'lastVisitDate', 300)
        && s(d, 'lastModified', 64) && sn(d, 'teamId', 300) && sn(d, 'createdAt', 64)
        && optInt(d, 'totalVisits', 0, 100000)
        && strList(d.get('medicalHistory', []), 15, 4600)
        && strList(d.get('allergies', []), 15, 4600)
        && strList(d.get('previousDiagnoses', []), 10, 3100)
        && strList(d.get('previousPrescriptions', []), 10, 3100);
    }

    match /patients/{pid} {
      allow get: if canViewPatients(resource.data.get('teamId', ''));
      allow list: if request.auth != null && request.query.limit <= 1000;
      allow create: if canEditPatients(request.resource.data.get('teamId', ''))
                    && validPatient(request.resource.data, pid)
                    && (bumped('patientCount', 1000) || request.resource.data.get('teamId', '') != '');
      allow update: if canEditPatients(request.resource.data.get('teamId', resource.data.get('teamId', '')))
                    && validPatient(request.resource.data, pid);
      allow delete: if isTeamOwner(resource.data.get('teamId', ''));

      // -------------------------------------------------------------- visits --
      function validExam(e) {
        return e is map
          && e.keys().hasOnly([
              'acuity', 'refraction', 'color', 'iop', 'iopMethod', 'anglesGonioscopy',
              'cdrOn', 'confrontationPeripheral', 'vanHerick', 'slitLampNotes',
              'fundoscopyNotes'])
          && e.get('acuity', {}) is map
          && e.get('acuity', {}).keys().hasOnly(['uncorrected', 'bestCorrected', 'pinhole', 'oldCc', 'ar', 'ak'])
          && e.get('refraction', {}) is map
          && e.get('refraction', {}).keys().hasOnly(['sph', 'cyl', 'axis', 'add'])
          && s(e, 'color', 300) && s(e, 'iop', 300) && s(e, 'iopMethod', 300)
          && s(e, 'anglesGonioscopy', 300) && s(e, 'cdrOn', 300)
          && s(e, 'confrontationPeripheral', 300) && s(e, 'vanHerick', 300)
          && s(e, 'slitLampNotes', 1000) && s(e, 'fundoscopyNotes', 1000);
      }
      function validEncounter(d, pid, eid) {
        return d.keys().hasOnly([
            'id', 'patientId', 'date', 'doctorName', 'chiefComplaint', 'examOD', 'examOS',
            'diagnosis', 'treatmentPlan', 'status', 'lastModified', 'paperSheet',
            'drawOD', 'drawOS', 'teamId'])
          && d.keys().hasAll(['id', 'patientId', 'date', 'lastModified'])
          && d.id == eid && d.patientId == pid
          && s(d, 'date', 300) && s(d, 'doctorName', 300) && s(d, 'status', 300)
          && s(d, 'lastModified', 64) && sn(d, 'teamId', 300)
          && s(d, 'chiefComplaint', 2000) && s(d, 'diagnosis', 2000) && s(d, 'treatmentPlan', 2000)
          && validExam(d.get('examOD', {}))
          && validExam(d.get('examOS', {}))
          && bytesUpTo(d, 'paperSheet', 20480)
          && bytesUpTo(d, 'drawOD', 8192)
          && bytesUpTo(d, 'drawOS', 8192);
      }

      match /encounters/{eid} {
        allow get: if canViewVisits(resource.data.get('teamId', patientTeamId(pid)));
        allow list: if canViewVisits(patientTeamId(pid)) && request.query.limit <= 200;
        allow create: if canWriteVisits(request.resource.data.get('teamId', patientTeamId(pid)))
                      && validEncounter(request.resource.data, pid, eid)
                      && (bumped('encounterCount', 20000) || request.resource.data.get('teamId', '') != '');
        allow update: if canWriteVisits(request.resource.data.get('teamId', resource.data.get('teamId', patientTeamId(pid))))
                      && validEncounter(request.resource.data, pid, eid);
        allow delete: if isTeamOwner(resource.data.get('teamId', patientTeamId(pid)));
      }

      // -------------------------------------------------------- prescriptions --
      function validRxItem(l, i) {
        return l.size() <= i || (
          l[i].keys().hasOnly(['id', 'medicationName', 'strength', 'dosage', 'frequency', 'duration', 'instructions'])
          && l[i].get('medicationName', '').size() <= 200
          && l[i].get('instructions', '').size() <= 300);
      }
      function validRxItems(l) {
        return l is list && l.size() <= 10
          && validRxItem(l, 0) && validRxItem(l, 1) && validRxItem(l, 2) && validRxItem(l, 3)
          && validRxItem(l, 4) && validRxItem(l, 5) && validRxItem(l, 6) && validRxItem(l, 7)
          && validRxItem(l, 8) && validRxItem(l, 9);
      }
      function validPrescription(d, pid, rid) {
        return d.keys().hasOnly([
            'id', 'patientId', 'encounterId', 'doctorName', 'date', 'items', 'notes',
            'lastModified', 'teamId', 'clinicBranch', 'followUpDate'])
          && d.keys().hasAll(['id', 'patientId', 'items', 'lastModified'])
          && d.id == rid && d.patientId == pid
          && s(d, 'encounterId', 300) && s(d, 'doctorName', 300) && s(d, 'date', 300)
          && s(d, 'notes', 1000) && s(d, 'lastModified', 64) && sn(d, 'teamId', 300)
          && sn(d, 'clinicBranch', 300) && sn(d, 'followUpDate', 300)
          && validRxItems(d.items);
      }

      match /prescriptions/{rid} {
        allow get: if canViewVisits(resource.data.get('teamId', patientTeamId(pid)));
        allow list: if canViewVisits(patientTeamId(pid)) && request.query.limit <= 200;
        allow create: if canWriteVisits(request.resource.data.get('teamId', patientTeamId(pid)))
                      && validPrescription(request.resource.data, pid, rid)
                      && (bumped('prescriptionCount', 20000) || request.resource.data.get('teamId', '') != '');
        allow update: if canWriteVisits(request.resource.data.get('teamId', resource.data.get('teamId', patientTeamId(pid))))
                      && validPrescription(request.resource.data, pid, rid);
        allow delete: if isTeamOwner(resource.data.get('teamId', patientTeamId(pid)));
      }
    }

    // ------------------------------------------------------- meta / counters --
    function counterStep(d, f, cap) {
      let before = resource == null ? 0 : resource.data.get(f, 0);
      let after = d.get(f, 0);
      return after is int && after >= before && after - before <= 1 && after <= cap;
    }
    function validCounters(d) {
      return d.keys().hasOnly(['patientCount', 'encounterCount', 'prescriptionCount'])
        && counterStep(d, 'patientCount', 1000)
        && counterStep(d, 'encounterCount', 20000)
        && counterStep(d, 'prescriptionCount', 20000);
    }

    match /meta/counters {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && validCounters(request.resource.data);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- users --
    match /users/{uid} {
      allow get: if request.auth != null && (
        request.auth.uid == uid ||
        isMasterAdmin() ||
        request.auth.token.email == 'admin.docrs@gmail.com' ||
        isStaff() ||
        isTeamOwner(resource.data.get('requestedWorkspaceId', resource.data.get('teamId', ''))) ||
        isTeamAdmin(resource.data.get('requestedWorkspaceId', resource.data.get('teamId', '')))
      );
      allow list: if request.auth != null && (isMasterAdmin() || isStaff() || request.auth.token.email == 'admin.docrs@gmail.com' || request.query.limit <= 100);
      allow create, update: if request.auth != null && (
        request.auth.uid == uid ||
        isMasterAdmin() ||
        request.auth.token.email == 'admin.docrs@gmail.com' ||
        isStaff() ||
        isTeamOwner(request.resource.data.get('requestedWorkspaceId', request.resource.data.get('teamId', ''))) ||
        isTeamAdmin(request.resource.data.get('requestedWorkspaceId', request.resource.data.get('teamId', ''))) ||
        (resource != null && (
          isTeamOwner(resource.data.get('requestedWorkspaceId', resource.data.get('teamId', ''))) ||
          isTeamAdmin(resource.data.get('requestedWorkspaceId', resource.data.get('teamId', '')))
        ))
      );
      allow delete: if request.auth != null && (isStaff() || isMasterAdmin());

      match /settings/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || isStaff());
      }
      match /preferences/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || isStaff());
      }
    }

    // ------------------------------------------------------ calendar & alerts --
    function validEvent(d, id) {
      return d.keys().hasOnly([
          'id', 'title', 'eventType', 'location', 'dateTime', 'patientName', 'patientId',
          'notes', 'reminderMinutes', 'isCompleted', 'lastModified', 'teamId'])
        && d.get('id', id) == id
        && s(d, 'title', 300) && s(d, 'eventType', 300) && s(d, 'location', 300)
        && s(d, 'dateTime', 64) && s(d, 'patientName', 300) && sn(d, 'patientId', 300)
        && s(d, 'notes', 1000) && s(d, 'lastModified', 64) && sn(d, 'teamId', 300)
        && optInt(d, 'reminderMinutes', 0, 10080)
        && optBool(d, 'isCompleted');
    }

    match /calendarEvents/{id} {
      allow get: if isStaff() || canViewPatients(resource.data.get('teamId', ''));
      allow list: if (isStaff() || request.auth != null) && request.query.limit <= 500;
      allow create, update: if isStaff() || canEditPatients(request.resource.data.get('teamId', ''));
      allow delete: if isStaff() || isTeamOwner(resource.data.get('teamId', ''));
    }

    function validNotification(d, id) {
      return d.keys().hasOnly([
          'id', 'title', 'message', 'category', 'severity', 'timestamp', 'patientName',
          'patientId', 'isRead', 'teamId'])
        && d.get('id', id) == id
        && s(d, 'title', 300) && s(d, 'message', 1000) && s(d, 'category', 300)
        && s(d, 'severity', 300) && s(d, 'timestamp', 64)
        && sn(d, 'patientName', 300) && sn(d, 'patientId', 300) && sn(d, 'teamId', 300)
        && optBool(d, 'isRead');
    }

    match /notifications/{id} {
      allow get: if isStaff() || canViewPatients(resource.data.get('teamId', ''));
      allow list: if (isStaff() || request.auth != null) && request.query.limit <= 500;
      allow create, update: if isStaff() || canEditPatients(request.resource.data.get('teamId', ''));
      allow delete: if isStaff() || isTeamOwner(resource.data.get('teamId', ''));
    }

    // ---------------------------------------------------------- everything else --
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
